# SQL Server Performance Tuning Repository - .gitignore

# ============================================
# IDE and Editor Files
# ============================================
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ssmssln
*.ssmssuo
*.ssmssqlproj.user

# ============================================
# SQL Server Files
# ============================================
*.bak
*.trn
*.ldf
*.mdf
*.ndf
*.log
*.xel
*.xem

# ============================================
# Temporary and Cache Files
# ============================================
*.tmp
*.temp
*.cache
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Project Specific
# ============================================
# Old/legacy files (should not be in repo)
old/
Enter/
pdf_content.txt
*.pdf

# ============================================
# Credentials and Secrets
# ============================================
# Remove credentials from .vscode/settings.json
# Keep only non-sensitive configuration

# ============================================
# Build and Output
# ============================================
bin/
obj/
*.dll
*.exe

# ============================================
# Documentation (if generated)
# ============================================
Trainer_Docs/*
!Trainer_Docs/Course_Guide_4Days.md
docs/_build/
*.docx
*.doc

# ============================================
# Archive Files
# ============================================
*.rar
*.zip
*.7z
*.tar
*.gz


# ZCode plan files
.zcode/

# ============================================
# Trainer Deliverables (course production output) — policy per Production Plan open question #3
# ============================================
!Trainer_Docs/Production_Plan_Course_and_Slides.md
!Trainer_Docs/Slide_Blueprints/
!Trainer_Docs/Slide_Blueprints/**
!Trainer_Docs/SignOff/
!Trainer_Docs/SignOff/**
!Trainer_Docs/Decks/
!Trainer_Docs/Decks/**
!Trainer_Docs/build_decks.py
!Trainer_Docs/_template_work.pptx
~$*

# ============================================
# Bundled lab tool: DiskSpd v2.3 + Microsoft whitepaper (Module 02 lab)
# Re-include over the global *.exe / *.docx rules — see Labs/Tools/README.md
# ============================================
!Module_02_IO/Labs/Tools/
!Module_02_IO/Labs/Tools/**
